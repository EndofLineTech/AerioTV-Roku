{
  "name": "aeriotv-roku",
  "version": "0.3.80",
  "private": true,
  "description": "Native Roku port of AerioTV — Dispatcharr-first development build",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "check": "bsc --project bsconfig.json --copy-to-staging false --create-package false",
    "build": "bsc --project bsconfig.json",
    "test": "node scripts/test.mjs",
    "test:package": "node --test scripts/verify-package.test.mjs",
    "test:tools": "python3 -m unittest scripts/roku_device_info_test.py",
    "verify": "npm test && npm run test:package && npm run test:tools && npm run check && npm run build && node scripts/verify-package.mjs",
    "release:prepare": "npm run verify && node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "brighterscript": "0.73.5",
    "brs": "0.39.0"
  },
  "overrides": {
    "source-map-resolve": "0.5.0",
    "uuid": "11.1.0"
  }
}
