sub main()
    a = userProfileFromVerified("slot-a", "00000000-0000-4000-8000-000000000001", {id: 7, username: "Alice", user_level: 1}, 1)
    b = userProfileFromVerified("slot-a", "00000000-0000-4000-8000-000000000002", {id: 8, username: "Bob", user_level: 1}, 1)
    b.isDefault = false
    store = defaultUserProfileStore("slot-a")
    store.profiles = [a, b]
    store.active = b.id
    recorded = userProfileRecordDefaultIdentity(store, false)
    check(recorded.ok and recorded.store["knownDefault"]["userId"] = 7 and recorded.store["knownDefault"]["username"] = "Alice", "recorded identity comes from the default profile, never cleared slot account metadata")
    check(recorded.store.profiles[1]["defaultIdentityTag"]["userId"] = 7, "an older non-default profile takes the recorded default identity once")
    entry = normalizeConnectionEntry({id: "slot-a", name: "Synthetic", provider: "dispatcharr", url: "https://old.test/base", accountId: "", accountUsername: "", remember: false})
    for each sameServer in ["httpS://OLD.test:443/other", "https://old.test/base/other"]
        planned = userProfileAddressChangePlan(entry, recorded.store, sameServer)
        check(planned.ok and not planned.changed and not planned.store.profiles[1].addressHeld and planned.store.active = b.id, "case, path and explicit default port do not hold or switch a profile")
    end for
    for each newServer in ["http://old.test", "https://old.test:444", "http://old.test:443"]
        check(userProfileAddressChangePlan(entry, recorded.store, newServer).changed, "scheme or effective-port changes hold profiles even when another origin part matches")
    end for
    ipv6 = setCanonicalPreference(entry, "url", "https://[2001:DB8::1]")
    check(not userProfileAddressChangePlan(ipv6, recorded.store, "HTTPS://[2001:db8::1]:443/new").changed, "IPv6 host case and explicit default port compare canonically")
    for each badUrl in ["https://user@other.test", "https://new.test:0", "https://new.test:99999", "not-a-url"]
        check(not userProfileAddressChangePlan(entry, recorded.store, badUrl).ok, "invalid addresses cannot stage a hold or URL replacement")
    end for
    held = userProfileAddressChangePlan(entry, recorded.store, "https://new.test")
    check(held.ok and held.changed and held.store.profiles[1].addressHeld and held.store.active = a.id, "new host holds every non-default profile, keyless included, and selects default in the plan")
    check(held.snapshot["userId"] = 7 and held.store["knownDefault"]["userId"] = 7 and not recorded.store.profiles[1].addressHeld, "address change captures the old recorded identity without mutating its caller")
    changedDefault = copyJson(held.store)
    changedDefault.profiles[0] = setCanonicalPreference(changedDefault.profiles[0], "userId", 70)
    changedDefault.profiles[0] = setCanonicalPreference(changedDefault.profiles[0], "username", "NewAlice")
    frozen = userProfileRecordDefaultIdentity(changedDefault, false)
    check(frozen.ok and frozen.store["knownDefault"]["userId"] = 7, "any held profile freezes the recorded identity even after a successful new default login")
    changedDefault.profiles[1].delete("defaultIdentityTag")
    migratedHeld = userProfileRecordDefaultIdentity(changedDefault, false)
    check(migratedHeld.ok and migratedHeld.store.profiles[1]["defaultIdentityTag"]["userId"] = 7, "a pre-existing held profile takes its missing tag from the frozen record, not the new live default")
    duringChange = userProfileRecordDefaultIdentity(recorded.store, true)
    check(duringChange.ok and FormatJson(duringChange.store) = FormatJson(recorded.store), "same-change verification cannot rewrite the snapshot before holds are committed")
    wrong = userProfileAddressCheckPlan(held.store, {id: 70, username: "NewAlice"})
    check(wrong.ok and wrong.store.profiles[1].addressHeld, "different default user cannot silently lift a held profile")
    wrong = userProfileAddressCheckPlan(held.store, {id: 7, username: "AnotherName"})
    check(wrong.ok and wrong.store.profiles[1].addressHeld, "matching user ID alone cannot pass the same-server check")
    lifted = userProfileAddressCheckPlan(held.store, {id: 7, username: "ALICE"})
    check(lifted.ok and not lifted.store.profiles[1].addressHeld and lifted.store.active = a.id, "own default ID and case-insensitive username lift matching tags without switching back")
    foreignTag = copyJson(held.store)
    foreignTag.profiles[1] = setCanonicalPreference(foreignTag.profiles[1], "defaultIdentityTag", {userId: 70, username: "NewAlice"})
    checked = userProfileAddressCheckPlan(foreignTag, {id: 7, username: "Alice"})
    check(checked.ok and checked.store.profiles[1].addressHeld, "a profile added or recovered against a different default tag stays held")
    c = userProfileFromVerified("slot-a", "00000000-0000-4000-8000-000000000003", {id: 9, username: "Charlie", user_level: 1}, 1)
    c.isDefault = false
    c = setCanonicalPreference(c, "addressHeld", true)
    c = setCanonicalPreference(c, "defaultIdentityTag", {userId: 7, username: "Alice"})
    foreignTag.profiles.push(c)
    partial = userProfileAddressCheckPlan(foreignTag, {id: 7, username: "Alice"})
    check(partial.ok and partial.store.profiles[1].addressHeld and not partial.store.profiles[2].addressHeld, "same-server checks lift matching holders independently while other tags keep the roster paused")
    unknownTag = copyJson(held.store)
    unknownTag.profiles[1] = setCanonicalPreference(unknownTag.profiles[1], "defaultIdentityTag", invalid)
    unknownRecorded = userProfileRecordDefaultIdentity(unknownTag, false)
    check(unknownRecorded.ok and unknownRecorded.store.profiles[1].doesExist("defaultIdentityTag") and unknownRecorded.store.profiles[1]["defaultIdentityTag"] = invalid, "explicit unknown tags are never mistaken for pre-feature missing tags")
    check(userProfileAddressCheckPlan(unknownTag, {id: 7, username: "Alice"}).store.profiles[1].addressHeld, "same-server checks cannot lift an explicitly unknown tag")
    recovered = userProfileAddressOwnTagPlan(held.store, b.id, {id: 8, username: "BOB"}, {id: 70, username: "NewAlice"}, true)
    check(recovered.ok and not recovered.store.profiles[1].addressHeld and recovered.store.profiles[1]["defaultIdentityTag"]["userId"] = 70 and recovered.store["knownDefault"]["userId"] = 7, "own sign-in tags the live default answer, not the frozen record, without replacing that record")
    recovered = userProfileAddressOwnTagPlan(held.store, b.id, {id: 8, username: "bob"}, invalid, true)
    check(recovered.ok and not recovered.store.profiles[1].addressHeld and recovered.store.profiles[1].doesExist("defaultIdentityTag") and recovered.store.profiles[1]["defaultIdentityTag"] = invalid, "own sign-in without a default answer at this address lifts only its own hold and records an explicit unknown tag")
    check(not userProfileAddressOwnTagPlan(held.store, b.id, {id: 7, username: "Alice"}, invalid, true).ok, "another holder's verified account cannot lift a profile address hold")
    check(not userProfileAddressOwnTagPlan(held.store, b.id, {id: 8, username: "bob"}, invalid, false).ok, "a saved-key check cannot lift an address hold even for the expected username")
    refreshed = userProfileAddressOwnTagPlan(recorded.store, b.id, {id: 8, username: "bob"}, {id: 70, username: "NewAlice"}, false)
    check(refreshed.ok and refreshed.store.profiles[1]["defaultIdentityTag"]["userId"] = 70, "unheld own-key verification may refresh its tag from the live default answer")
    noRecord = userProfileAddressChangePlan(entry, store, "https://new.test")
    check(noRecord.ok and noRecord.snapshot = invalid and noRecord.store.profiles[1].addressHeld, "missing recorded identity still holds keyless profiles rather than trusting cleared slot fields")
    check(userProfileAddressCheckPlan(noRecord.store, {id: 7, username: "Alice"}).store.profiles[1].addressHeld, "a new live default answer cannot invent an old snapshot and lift a hold")
    corrupt = setCanonicalPreference(recorded.store, "knownDefault", {userId: 7.0, username: "Alice"})
    check(not userProfileAddressChangePlan(entry, corrupt, "https://new.test").ok, "malformed recorded identity is recovery, not a missing permissive snapshot")
    corrupt = copyJson(recorded.store)
    corrupt.profiles[1] = setCanonicalPreference(corrupt.profiles[1], "defaultIdentityTag", {userId: 7, username: ""})
    check(normalizeUserProfileStore(corrupt, "slot-a").readOnly, "malformed profile address tag fences the stored roster")
    child = copyJson(recorded.store)
    child.profiles[1] = setCanonicalPreference(child.profiles[1], "role", "child")
    check(not userProfileAddressChangePlan(entry, child, "https://new.test").ok, "an active Child cannot edit server addresses through this pure handler boundary")
    childDefault = copyJson(recorded.store)
    childDefault.profiles[0] = setCanonicalPreference(childDefault.profiles[0], "role", "child")
    childLanding = userProfileAddressChangePlan(entry, childDefault, "https://new.test")
    check(childLanding.ok and childLanding.childDefault and childLanding.store.active = a.id, "an adult's address edit explicitly identifies a Child-default landing instead of authorizing general setup")
    print "ALL TESTS PASSED"
end sub

sub check(passed as boolean, message as string)
    if not passed then print "FAIL: "; message : stop
end sub
