sub main()
    scope = ParseJson("{""playlistId"":""slot-a"",""profileId"":""00000000-0000-4000-8000-000000000001"",""accountId"":""7"",""preferenceIdentity"":""https://example.test|7|slot-a"",""authorizationGeneration"":""own"",""sessionId"":""00000000-0000-4000-8000-000000000090""}")
    state = dispatcharrSyncScheduleBind(invalid, scope, 100)
    denied = dispatcharrSyncScheduleTake(state, scope, 100, false)
    check(not denied.run, "closed content/hold/opt-out gate cannot launch scheduled work")
    first = dispatcharrSyncScheduleTake(state, scope, 100, true)
    check(first.run and not first.push and first.ticket.scope.sessionId = scope.sessionId, "session start schedules an own read, not an invented authenticated lifecycle")
    check(not dispatcharrSyncScheduleTake(first.state, scope, 100, true).run, "one in-flight operation per scheduler")
    state = dispatcharrSyncScheduleComplete(first.state, first.ticket, true, 101)
    state = dispatcharrSyncScheduleDirty(state, scope, "root-1", true, 102)
    check(not dispatcharrSyncScheduleTake(state, scope, 102, true).run, "roster mutation waits one-second debounce")
    state = dispatcharrSyncScheduleDirty(state, scope, "root-2", true, 102)
    state = dispatcharrSyncScheduleDirty(state, scope, "root-3", true, 103)
    check(not dispatcharrSyncScheduleTake(state, scope, 103, true).run, "new edit resets debounce rather than flushing an earlier root")
    write = dispatcharrSyncScheduleTake(state, scope, 104, true)
    check(write.run and write.push and write.ticket.root = "root-3", "debounced operation captures exact durable dirty root")
    state = dispatcharrSyncScheduleComplete(write.state, write.ticket, false, 104)
    check(not dispatcharrSyncScheduleTake(state, scope, 133, true).run, "failed write cannot create an immediate retry storm")
    retry = dispatcharrSyncScheduleTake(state, scope, 134, true)
    check(retry.run and retry.push and retry.ticket.root = "root-3", "bounded later retry retains dirty intent")
    state = dispatcharrSyncScheduleComplete(retry.state, retry.ticket, false, 134)
    check(not dispatcharrSyncScheduleTake(state, scope, 253, true).run, "second failed attempt waits two minutes")
    retry = dispatcharrSyncScheduleTake(state, scope, 254, true)
    state = dispatcharrSyncScheduleComplete(retry.state, retry.ticket, false, 254)
    check(not dispatcharrSyncScheduleTake(state, scope, 853, true).run, "subsequent failure waits ten minutes")
    retry = dispatcharrSyncScheduleTake(state, scope, 854, true)
    state = dispatcharrSyncScheduleComplete(retry.state, retry.ticket, true, 854)
    state = dispatcharrSyncScheduleDirty(state, scope, "clean-root", false, 854)
    check(not dispatcharrSyncScheduleTake(state, scope, 855, true).run, "acknowledged clean durable root does not queue another write")
    ' Independent picker timeline, not a backwards wall-clock simulation.
    state = dispatcharrSyncScheduleBind(invalid, scope, 160)
    start = dispatcharrSyncScheduleTake(state, scope, 160, true)
    state = dispatcharrSyncScheduleComplete(start.state, start.ticket, true, 160)
    state = dispatcharrSyncScheduleRequest(state, scope, "picker", 170)
    pull = dispatcharrSyncScheduleTake(state, scope, 170, true)
    check(pull.run and not pull.push, "picker opening schedules immediate profiles read")
    state = dispatcharrSyncScheduleComplete(pull.state, pull.ticket, true, 170)
    state = dispatcharrSyncScheduleRequest(state, scope, "picker", 171)
    check(not dispatcharrSyncScheduleTake(state, scope, 171, true).run, "repeated picker open cannot bypass thirty-second slot throttle")
    reread = dispatcharrSyncScheduleTake(state, scope, 172, true)
    check(reread.run and not reread.push, "one picker re-read occurs two seconds later")
    state = dispatcharrSyncScheduleComplete(reread.state, reread.ticket, true, 172)
    check(not dispatcharrSyncScheduleTake(state, scope, 173, true).run, "picker re-read does not recursively schedule another re-read")
    state = dispatcharrSyncScheduleRequest(state, scope, "picker", 199)
    check(not dispatcharrSyncScheduleTake(state, scope, 199, true).run, "slot throttle includes whole thirty-second window")
    state = dispatcharrSyncScheduleRequest(state, scope, "picker", 200)
    check(dispatcharrSyncScheduleTake(state, scope, 200, true).run, "picker throttle expires at thirty seconds")
    successor = setCanonicalPreference(scope, "sessionId", "00000000-0000-4000-8000-000000000091")
    rebound = dispatcharrSyncScheduleBind(state, successor, 201)
    old = dispatcharrSyncScheduleComplete(rebound, reread.ticket, false, 201)
    check(FormatJson(old) = FormatJson(rebound) and not dispatcharrSyncScheduleTake(rebound, scope, 201, true).run, "old-scope queued work and late completions cannot run in successor session")
    fresh = dispatcharrSyncScheduleTake(rebound, successor, 201, true)
    state = dispatcharrSyncScheduleComplete(fresh.state, fresh.ticket, true, 201)
    state = dispatcharrSyncScheduleRequest(state, successor, "picker", 202)
    check(not dispatcharrSyncScheduleTake(state, successor, 202, true).run, "picker throttle survives same-slot session replacement")
    check(not dispatcharrSyncScheduleTake(state, successor, 1100, true).run and dispatcharrSyncScheduleTake(state, successor, 1101, true).run, "regular cadence is fifteen minutes, not per-frame polling")
    state = dispatcharrSyncScheduleRequest(state, successor, "network-return", 300)
    check(dispatcharrSyncScheduleTake(state, successor, 300, true).run, "explicit network return requests fresh own discovery")
    check(instr(1, FormatJson(state), "apiKey") = 0 and instr(1, FormatJson(state), "pinHash") = 0, "scheduler holds no credential or PIN material")
    state = dispatcharrSyncScheduleBind(invalid, scope, 2000)
    state = dispatcharrSyncScheduleDirty(state, scope, "oversize-root", true, 2000)
    work = dispatcharrSyncScheduleTake(state, scope, 2001, true)
    state = dispatcharrSyncScheduleComplete(work.state, work.ticket, false, 2001, "too-large")
    check(not dispatcharrSyncScheduleTake(state, scope, 2002, true).run and state.pause = "too-large", "oversize stops writes instead of retrying the same body")
    read = dispatcharrSyncScheduleTake(state, scope, 2901, true)
    check(read.run and not read.push, "oversize still permits regular read-only discovery")
    state = dispatcharrSyncScheduleComplete(read.state, read.ticket, true, 2901)
    state = dispatcharrSyncScheduleDirty(state, scope, "imported-root", true, 2901, false)
    check(not dispatcharrSyncScheduleTake(state, scope, 2902, true).run, "imported metadata is not a new local edit and cannot unblock oversize writes or spin reads")
    state = dispatcharrSyncScheduleDirty(state, scope, "new-local-root", true, 2903)
    check(dispatcharrSyncScheduleTake(state, scope, 2904, true).push, "next genuine local change may attempt a newly checked body")
    state = dispatcharrSyncScheduleBind(invalid, scope, 3000)
    work = dispatcharrSyncScheduleTake(state, scope, 3000, true)
    state = dispatcharrSyncScheduleComplete(work.state, work.ticket, false, 3000, "signin-required")
    check(state.pause = "signin-required" and not dispatcharrSyncScheduleTake(state, scope, 3899, true).run, "list/PUT authorization pause waits for next regular session attempt rather than storming credentials")
    work = dispatcharrSyncScheduleTake(state, scope, 3900, true)
    state = dispatcharrSyncScheduleComplete(work.state, work.ticket, true, 3900)
    check(state.pause = "", "good fresh discovery clears memory-only sign-in pause")
    state = dispatcharrSyncScheduleBind(invalid, scope, 4000)
    work = dispatcharrSyncScheduleTake(state, scope, 4000, true)
    state = dispatcharrSyncScheduleComplete(work.state, work.ticket, false, 4000, "storage-full")
    check(state.creationBlocked and state.pause = "storage-full", "max_apps blocks only creation in the actual sync session")
    rebound = dispatcharrSyncScheduleBind(state, successor, 4001)
    check(not rebound.creationBlocked, "server capacity pause is memory-only and cannot leak to a successor profile session")
    print "ALL TESTS PASSED"
end sub

sub check(passed as boolean, message as string)
    if not passed then print "FAIL: "; message : stop
end sub
