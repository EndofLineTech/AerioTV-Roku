    <field id="config" type="assocarray" onChange="configureVod" />
    <field id="active" type="boolean" onChange="activateVod" />
    <field id="playRequested" type="assocarray" alwaysNotify="true" />
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
    <field id="savedState" type="array" />
    <field id="permissions" type="assocarray" onChange="updateLibraryTabs" />
    <field id="stateChange" type="assocarray" alwaysNotify="true" />
    <field id="bookmark" type="assocarray" alwaysNotify="true" />
    <field id="destination" type="string" alwaysNotify="true" />
    <function name="cancelVod" />
    <function name="libraryStatus" />
    <function name="handleLibraryKey" />
    <function name="saveLibraryBookmark" />
    <function name="openVodSearch" />
