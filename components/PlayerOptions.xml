<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerOptions" extends="Group">
  <interface>
    <field id="menu" type="assocarray" onChange="setMenu" />
    <field id="active" type="boolean" value="false" onChange="onActive" />
    <field id="selection" type="assocarray" alwaysNotify="true" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <field id="backRequested" type="boolean" alwaysNotify="true" />
    <field id="focusedIndex" type="integer" value="0" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/SceneUi.brs" />
  <script type="text/brightscript" uri="PlayerOptions.brs" />
</component>
