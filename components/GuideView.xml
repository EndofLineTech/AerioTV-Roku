<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideView" extends="Group">
  <interface>
    <field id="archiveRequest" type="assocarray" alwaysNotify="true" />
    <field id="metadataEvent" type="assocarray" alwaysNotify="true" />
    <field id="channelFacts" type="assocarray" onChange="onCatchupCapabilities" />
    <field id="catchupPermission" type="string" value="unknown" onChange="onCatchupCapabilities" />
    <field id="moviesPermission" type="string" value="unknown" onChange="updatePrimaryTabs" />
    <field id="seriesPermission" type="string" value="unknown" onChange="updatePrimaryTabs" />
    <field id="vodEnabled" type="boolean" value="true" />
    <field id="config" type="assocarray" onChange="configure" />
    <field id="active" type="boolean" value="false" onChange="onActive" />
    <field id="watchChannel" type="assocarray" alwaysNotify="true" />
    <field id="exitRequested" type="boolean" alwaysNotify="true" />
    <field id="preferences" type="assocarray" alwaysNotify="true" />
    <field id="playbackChannel" type="assocarray" onChange="onPlaybackChannel" />
    <field id="playbackEpoch" type="integer" value="0" onChange="onPlaybackTime" />
    <field id="playbackInfo" type="assocarray" alwaysNotify="true" />
    <field id="miniActive" type="boolean" onChange="updateMiniLayout" />
    <field id="sleepActive" type="boolean" />
    <field id="pendingTune" type="boolean" />
    <field id="playerRequest" type="string" alwaysNotify="true" />
    <field id="devicePreference" type="assocarray" alwaysNotify="true" />
    <field id="remotePreferences" type="assocarray" />
    <function name="adjacentPlayingChannel" />
    <function name="selectPlayingChannel" />
    <function name="cachedPlaybackInfo" />
    <function name="playerBrowserData" />
    <function name="browserNowTitles" />
    <function name="channelByUuid" />
    <field id="recentIds" type="array" onChange="updateHistory" />
    <function name="applyRefreshedLineup" />
    <function name="refreshPresentation" />
    <function name="applyHubGuideSetting" />
    <function name="handleOptionsShortcut" />
    <function name="focusPrimaryNavigation" />
    <function name="cancelMappingLoad" />
    <function name="cancelMetadataLoads" />
    <function name="forgetStoredMetadata" />
    <field id="reminderState" type="array" onChange="updateReminders" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/DispatcharrModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/GuideModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/TaskSupport.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/NowNextModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/SceneUi.brs" />
  <script type="text/brightscript" uri="pkg:/source/RemoteMapModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/PreferenceModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/GuideSettingsModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/ReminderModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/MetadataCacheModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/MediaSessionModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/CatchupModel.brs" />
  <script type="text/brightscript" uri="GuideCache.brs" />
  <script type="text/brightscript" uri="GuideView.brs" />
  <script type="text/brightscript" uri="GuideRemoteInput.brs" />
  <script type="text/brightscript" uri="GuideSettings.brs" />
  <script type="text/brightscript" uri="GuideDetails.brs" />
  <children>
    <Group id="canvas" />
    <TopNavigation id="primaryNavigation" translation="[560,20]" selected="live" />
    <GroupNavigator id="groupNavigator" visible="false" />
    <ProgramSearchView id="programSearch" visible="false" />
    <ProgramDetails id="programDetails" visible="false" />
    <Timer id="detailDelay" duration="0.35" repeat="false" />
    <Timer id="loadDelay" duration="0.15" repeat="false" />
    <Timer id="clock" duration="30" repeat="true" />
    <Timer id="saveDelay" duration="0.8" repeat="false" />
    <Timer id="holdTimer" duration="0.4" repeat="true" />
  </children>
</component>
