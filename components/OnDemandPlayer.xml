<?xml version="1.0" encoding="utf-8" ?>
<component name="OnDemandPlayer" extends="Group">
  <interface>
    <field id="request" type="assocarray" onChange="openMedia" />
    <field id="closed" type="boolean" alwaysNotify="true" />
    <field id="progress" type="assocarray" alwaysNotify="true" />
    <field id="diagnostic" type="assocarray" alwaysNotify="true" />
    <field id="archiveSeek" type="integer" alwaysNotify="true" />
    <field id="goLiveRequested" type="boolean" alwaysNotify="true" />
    <function name="closeMedia" />
    <function name="suspendArchive" />
    <function name="openArchiveActions" />
  </interface>
  <script type="text/brightscript" uri="pkg:/source/DispatcharrModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/SceneUi.brs" />
  <script type="text/brightscript" uri="pkg:/source/PlaybackModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/MediaSessionModel.brs" />
  <script type="text/brightscript" uri="pkg:/source/CatchupModel.brs" />
  <script type="text/brightscript" uri="OnDemandPlayer.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000FF" />
    <Video id="mediaVideo" width="1920" height="1080" enableUI="true" allowOptionsKeyOverride="false" />
    <Timer id="progressClock" duration="5" repeat="true" />
  </children>
</component>
