  <children>
    <Group id="screen" />
    <GuideView id="guide" visible="false" />
    <VodView id="vodLibrary" visible="false" />
    <OnDemandPlayer id="onDemandPlayer" visible="false" />
    <Group id="miniFrame" visible="false">
      <Rectangle translation="[1420,12]" width="408" height="233" color="0x1AC4D8FF" />
      <Label id="miniCaption" translation="[1424,245]" width="400" height="22" maxLines="1" wrap="false" font="font:SmallestSystemFont" color="0x1AC4D8FF" />
    </Group>
    <Group id="videoViewport" clippingRect="[0,0,1920,1080]">
      <AerioVideo id="video" visible="false" width="1920" height="1080" enableUI="false" allowOptionsKeyOverride="false" focusable="true" />
    </Group>
    <Group id="playerInput" focusable="true" />
    <PlayerInfo id="playerBanner" visible="false" />
    <PlayerControls id="transport" visible="false" />
    <ChannelBrowser id="channelBrowser" visible="false" />
    <PlayerOptions id="playerOptions" visible="false" />
    <Group id="pictureCover" visible="false">
      <Rectangle width="1920" height="1080" color="0x000000FF" />
      <Group id="pictureHint">
        <Label translation="[160,780]" width="1600" height="60" text="Picture hidden — foreground listening" font="font:MediumSystemFont" color="0x9EB5C9FF" />
        <Label translation="[160,854]" width="1600" height="110" wrap="true" text="Press an arrow, OK, or Back to restore the picture. Play/Pause still works.&#10;Keep AerioTV open; the full video stream is still received." font="font:SmallSystemFont" color="0x9EB5C9FF" />
      </Group>
    </Group>
    <Timer id="pictureHintTimer" duration="6" repeat="false" />
    <SettingsHub id="settingsHub" visible="false" />
    <Timer id="bannerTimer" duration="8" repeat="false" />
    <Timer id="playerClock" duration="1" repeat="true" />
    <Timer id="audioCheck" duration="5" repeat="false" />
    <Timer id="aacWaitTimer" duration="0.25" repeat="true" />
    <Timer id="sourceWatch" duration="3" repeat="true" />
    <Timer id="reminderClock" duration="30" repeat="true" />
    <Timer id="connectionClock" duration="1" repeat="true" />
    <Timer id="channelTuneTimer" duration="0.25" repeat="false" />
    <Timer id="heldZapTimer" duration="0.4" repeat="true" />
    <Timer id="capabilityClock" duration="300" repeat="true" />
    <Group id="notice" visible="false">
      <Rectangle translation="[160,28]" width="1600" height="92" color="0x172D43F5" />
      <Label id="noticeText" translation="[184,44]" width="1552" height="72" wrap="true" font="font:SmallSystemFont" color="0xE8F3FAFF" />
    </Group>
    <Timer id="noticeTimer" duration="8" repeat="false" />
    <Timer id="playerOkTimer" duration="1" repeat="false" />
  </children>
